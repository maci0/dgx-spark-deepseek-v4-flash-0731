# 2x DGX Spark (GB10) DeepSeek-V4-Flash-0731 DSpark NVFP4-KV 1M profile.
# Copy to .env.dspark on the head node; the launcher rsyncs it to the worker.

# --- cluster (use RoCE fabric IPs for MASTER/HOST_IP) ---
WORKER_HOST=192.168.0.212          # ssh-reachable worker (mgmt IP fine)
MASTER_ADDR=10.0.1.1               # head fabric IP
VLLM_HOST_IP=10.0.1.1              # head fabric IP (must be THIS node's own IP)
WORKER_VLLM_HOST_IP=10.0.1.2       # worker fabric IP
MASTER_PORT=25000
NODE_RANK=0

# --- RoCE ---
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=3                # RoCE v2

# --- model + cache ---
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731   # or apetersson/...-Abliterated-FP8
HF_CACHE=${HOME}/.cache/huggingface
SERVED_MODEL_NAME=deepseek-v4-flash
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# --- the actual tuning knobs ---
MAX_MODEL_LEN=1048576              # 1M, native YaRN ceiling
KV_CACHE_DTYPE=nvfp4_ds_mla        # the 1M enabler (NVFP4 KV)
MAX_NUM_SEQS=6                     # >=3 for 2-3 concurrent chats
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85        # biggest lever: 0.78->1.18M vs 0.85->2.77M KV tokens
MTP_NUM_TOKENS=5                   # DSpark k; LOCKED at 5 (must be multiple of n_predict=5)

DSPARK_VLLM_IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c
